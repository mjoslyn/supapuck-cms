---
import { site } from '../../lib/site';
import Admin from '../../layouts/Admin.astro';
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/admin/';
const message = error === 'forbidden' ? 'This account does not have editor access.' : error;
const sent = Astro.url.searchParams.has('sent');
const forgot = Astro.url.searchParams.has('forgot');
---
<Admin title="Sign in">
  <div class="mx-auto mt-24 max-w-sm">
    <h1 class="text-3xl font-normal">Sign in</h1>
    <p class="mt-2 text-sm text-admin-muted">{site.organization} site editor.</p>
    {sent && <p class="mt-6 rounded border border-[#6b8f71]/30 bg-[#6b8f71]/5 px-3 py-2 text-sm text-[#4d6b52]">If that address has an account, a link to set a new password is on its way.</p>}
    {message && <p class="mt-6 rounded border border-[#c4592a]/30 bg-[#c4592a]/5 px-3 py-2 text-sm text-[#c4592a]">{message}</p>}
    <form method="post" action="/api/auth/login" class="mt-6 space-y-4">
      <input type="hidden" name="next" value={next} />
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Email</span>
        <input name="email" type="email" required autocomplete="username" class="w-full rounded border border-admin-ink/20 bg-white px-3 py-2 outline-none focus:border-admin-accent" />
      </label>
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Password</span>
        <input name="password" type="password" required autocomplete="current-password" class="w-full rounded border border-admin-ink/20 bg-white px-3 py-2 outline-none focus:border-admin-accent" />
      </label>
      <button class="w-full rounded-sm bg-admin-ink px-4 py-2.5 text-sm font-semibold tracking-wider text-white uppercase hover:bg-admin-accent">Sign in</button>
    </form>
    <details class="mt-6 text-sm" open={forgot}>
      <summary class="cursor-pointer text-admin-muted hover:text-admin-ink">Forgot your password?</summary>
      <form method="post" action="/api/auth/forgot" class="mt-3 flex gap-2">
        <input name="email" type="email" required aria-label="Email for the reset link" placeholder="Your email" class="min-w-0 flex-1 rounded border border-admin-ink/20 bg-white px-3 py-2 outline-none focus:border-admin-accent" />
        <button class="rounded border border-admin-ink/20 px-3 py-2 hover:border-admin-accent hover:text-admin-accent">Send link</button>
      </form>
    </details>
  </div>
</Admin>
