---
import Admin from '../../../layouts/Admin.astro';
const { data, error } = await Astro.locals.db.from('templates').select('kind, slug, title, updated_at, linked:content->root->props->linked').in('kind', ['template', 'part', 'pattern']).order('kind').order('slug');
if (error) throw error;
const groups = [
  { kind: 'part', label: 'Template parts', note: 'Shared sections such as the header and footer.' },
  { kind: 'template', label: 'Templates', note: 'Page layouts chosen by the template hierarchy or per page.' },
  { kind: 'pattern', label: 'Patterns', note: 'Reusable groups of blocks. Insert one from the Patterns tab in the editor; the page gets its own copy to edit.' },
];
---
<Admin title="Templates">
  <h1 class="font-[Fraunces,Georgia,serif] text-3xl font-normal">Templates</h1>
  {groups.map((g) => (
    <section class="mt-8">
      <h2 class="text-sm font-semibold tracking-wider text-[#64748b] uppercase">{g.label}</h2>
      <p class="text-sm text-[#64748b]">{g.note}</p>
      <ul class="mt-3 grid grid-cols-3 gap-3">
        {(data ?? []).filter((t) => t.kind === g.kind).map((t) => (
          <li class="relative">
            <a href={`/admin/templates/${t.kind}/${t.slug}/`} class="block rounded bg-white p-4 pr-24 shadow-[0_0_0_1px_rgba(26,26,46,0.08)] hover:shadow-[0_0_0_2px_#b87333]">
              <span class="font-medium">{t.title || t.slug}</span>
              {(t as any).linked === true && <span class="ml-1.5 rounded bg-[#b87333]/15 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-[#8a5525] uppercase">Linked</span>}
              <span class="block text-xs text-[#64748b]">{t.slug}</span>
            </a>
            <form method="post" action="/api/admin/templates" class="absolute top-4 right-4">
              <input type="hidden" name="kind" value={t.kind} />
              <input type="hidden" name="slug" value={t.slug} />
              <button class="text-xs text-[#64748b] hover:text-[#b87333]" aria-label={`Duplicate ${t.title || t.slug}`}>Duplicate</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Admin>
