---
// Set a password: where invitation and password-reset emails land. An invitation arrives with the
// session in the URL fragment (the script below stores it); a reset link arrives with ?code= (exchanged
// here, in the browser that asked for it). Then the form sets the password (/api/auth/password).
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';

const code = Astro.url.searchParams.get('code');
if (code) {
  const { error } = await serverClient(Astro.request, Astro.cookies).auth.exchangeCodeForSession(code);
  return Astro.redirect(error ? `/admin/set-password/?error=${encodeURIComponent('That link has expired or was already used. Ask for a new one.')}` : '/admin/set-password/');
}
const error = Astro.url.searchParams.get('error');
const { data: { user } } = await serverClient(Astro.request, Astro.cookies).auth.getUser();
---
<Admin title="Set your password">
  <div class="mx-auto mt-24 max-w-sm">
    <h1 class="font-[Fraunces,Georgia,serif] text-3xl font-normal">Set your password</h1>
    <p class="mt-2 text-sm text-[#64748b]" id="who">{user ? `For ${user.email}.` : 'Checking your link…'}</p>
    {error && <p class="mt-6 rounded border border-[#c4592a]/30 bg-[#c4592a]/5 px-3 py-2 text-sm text-[#c4592a]">{error}</p>}
    <form method="post" action="/api/auth/password" class="mt-6 space-y-4" id="form" hidden={!user}>
      <label class="block text-sm">
        <span class="mb-1 block font-medium">New password</span>
        <input name="password" type="password" required minlength="10" autocomplete="new-password" class="w-full rounded border border-[#1a1a2e]/20 bg-white px-3 py-2 outline-none focus:border-[#b87333]" />
      </label>
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Repeat it</span>
        <input name="confirm" type="password" required minlength="10" autocomplete="new-password" class="w-full rounded border border-[#1a1a2e]/20 bg-white px-3 py-2 outline-none focus:border-[#b87333]" />
      </label>
      <button class="w-full rounded-sm bg-[#1a1a2e] px-4 py-2.5 text-sm font-semibold tracking-wider text-white uppercase hover:bg-[#b87333]">Save password</button>
    </form>
    <p class="mt-6 text-sm" id="expired" hidden><span class="text-[#64748b]">This link has expired or was already used.</span> <a href="/admin/login/?forgot=1" class="underline hover:text-[#b87333]">Send a new one</a></p>
  </div>
</Admin>
<script>
  import { browserClient } from '../../lib/supabase-browser';
  // Invitations put the session in the fragment: store it (as the shared session cookie) and reload.
  const hash = new URLSearchParams(location.hash.slice(1));
  const form = document.getElementById('form')!;
  if (hash.get('access_token') && hash.get('refresh_token')) {
    browserClient()
      .auth.setSession({ access_token: hash.get('access_token')!, refresh_token: hash.get('refresh_token')! })
      .then(({ error }) => {
        if (error) location.replace(`/admin/set-password/?error=${encodeURIComponent(error.message)}`);
        else location.replace('/admin/set-password/');
      });
  } else if (form.hidden) {
    // No session: the link was expired, used, or opened without one.
    document.getElementById('who')!.hidden = true;
    document.getElementById('expired')!.hidden = false;
  }
</script>
