---
import { SITE_TZ, site } from '../lib/site';
// Admin chrome. Tailwind only; the public site's CSS never loads here.
import '../styles/tailwind.css';
import '../styles/admin.css';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const isAdmin = user?.role === 'admin';
const nav = [
  { href: '/admin/', label: 'Content' },
  { href: '/admin/templates/', label: 'Templates' },
  { href: '/admin/media/', label: 'Media' },
  { href: '/admin/forms/', label: 'Forms' },
  { href: '/admin/submissions/', label: 'Submissions' },
  { href: '/admin/settings/', label: 'Settings', admin: true },
  { href: '/admin/users/', label: 'Users', admin: true },
].filter((n) => !n.admin || isAdmin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ siteTz: SITE_TZ }}>window.__siteTz = siteTz;</script>
    <title>{title} · {site.name} admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#faf8f5] font-[Work_Sans,system-ui,sans-serif] text-[#1a1a2e] antialiased">
    {
      user && (
        <header class="bg-[#1a1a2e] text-white">
          <div class="mx-auto flex h-14 max-w-[1280px] items-center gap-6 px-6">
            <a href="/admin/" class="shrink-0 whitespace-nowrap font-[Fraunces,Georgia,serif] text-lg tracking-wide text-white">{site.name}</a>
            {/* One line: items never wrap; when space runs out the menu scrolls sideways. */}
            <nav class="admin-nav -my-2 flex min-w-0 flex-1 gap-1 overflow-x-auto py-2 text-sm" aria-label="Admin">
              {nav.map((n) => (
                <a href={n.href} class:list={['shrink-0 whitespace-nowrap rounded px-3 py-1.5 transition-colors', (n.href === '/admin/' ? path === '/admin/' || path.startsWith('/admin/content') || path.startsWith('/admin/compose') : path.startsWith(n.href)) ? 'bg-white/15 text-white' : 'text-white/65 hover:bg-white/10 hover:text-white']}>
                  {n.label}
                </a>
              ))}
            </nav>
            <div class="flex shrink-0 items-center gap-4 text-sm text-white/65">
              <a href="/" target="_blank" class="whitespace-nowrap hover:text-white">View site</a>
              <details class="relative">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pr-2 pl-1 hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label="Account">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#b87333] text-xs font-semibold text-white uppercase">{(user.name || user.email).slice(0, 1)}</span>
                  <span class="max-w-32 truncate text-white">{user.name || user.email.split('@')[0]}</span>
                </summary>
                <div class="absolute right-0 z-50 mt-2 w-64 rounded-lg border border-[#1a1a2e]/10 bg-white p-3 text-[#64748b] shadow-lg">
                  <div class="truncate font-medium text-[#1a1a2e]">{user.email}</div>
                  <div class="mb-3 text-xs">{user.role === 'admin' ? 'Admin' : 'Editor'}</div>
                  <form method="post" action="/api/auth/logout">
                    <button class="w-full rounded border border-[#1a1a2e]/15 px-3 py-1.5 text-left hover:border-[#b87333] hover:text-[#b87333]">Sign out</button>
                  </form>
                </div>
              </details>
            </div>
          </div>
        </header>
      )
    }
    <main class:list={[wide ? '' : 'mx-auto max-w-[1280px] px-6 py-8']}>
      {Astro.url.searchParams.get('error') === 'admins-only' && <p class="mb-4 rounded bg-[#c4592a]/10 px-3 py-2 text-sm text-[#c4592a]">That section is for admins.</p>}
      <slot />
    </main>
  </body>
</html>
